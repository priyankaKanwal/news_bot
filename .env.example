QDRANT_URL=http://localhost:6333

# LLM (Google Gemini) - get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
LLM_MODEL=gemini-3.5-flash

# Embeddings (Jina AI) - get a key at https://jina.ai/embeddings
JINA_API_KEY=

RETRIEVE_TOP_K=10
SCORE_THRESHOLD=0.60
RERANK_TOP_N=3
USE_RERANKER=1s
NEAR_DUPLICATE_THRESHOLD=0.88

# Daily ingestion schedule (2:00 AM IST)
INGESTION_SCHEDULE_HOUR=2
INGESTION_SCHEDULE_MINUTE=0
INGESTION_TIMEZONE=Asia/Kolkata

POSTGRES_DB=news_bot
POSTGRES_USER=news_bot
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://news_bot:change-me@localhost:5434/news_bot
CORS_ORIGINS=http://localhost:5173
